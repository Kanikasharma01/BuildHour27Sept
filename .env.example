# Copy this file to .env and fill in the real values.
# .env is gitignored and must never be committed.
#
# 1. GROQ_API_KEY - from https://console.groq.com/keys
# 2. GROQ_MODEL   - an EXPLICIT model id from Groq's current model list.
#                    Do not use a provider alias: aliases change what they point
#                    at, which would make the demo non-reproducible.

GROQ_API_KEY=
GROQ_MODEL=
