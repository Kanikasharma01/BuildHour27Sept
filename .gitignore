# Secrets - the Groq API key must never be committed.
# Copy .env.example to .env and fill in the real values locally.
.env
.env.*
!.env.example

# Virtual environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# chroma_db/ is intentionally NOT ignored. It is still a build artifact - vectors
# are not source - and it is still rebuilt from data/raw/ via `python -m ingest
# --cache-only`, so nothing in it is authoritative. But it is committed because
# Streamlit Community Cloud runs only `streamlit run app.py` with no build step,
# so a committed collection is the only way the app can find its corpus there.
# app.py still refuses to start if the collection is missing, so a stale checkout
# fails loudly instead of silently answering from nothing.
#
# If you change data/raw/ or ingest.py, rebuild and commit it in the same change:
#   python -m ingest --cache-only --force-rebuild
# Otherwise Cloud keeps serving the previously committed vectors.

# Streamlit
.streamlit/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
node_modules/

# NOTE: data/raw/ and data/chunks.txt are intentionally NOT ignored.
# The fetched public page text and the human-readable chunks are demo
# artifacts we want committed so the corpus is inspectable and reproducible.
